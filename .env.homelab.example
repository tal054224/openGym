# Copy to .env for docker-compose.homelab.yml. Never commit the real file.
# Private hostname: the passkey RP ID. Passkeys are bound to this exact name and run only here.
PRIVATE_HOST=gym.home.example
# The LAN or WireGuard address to publish the private HTTPS port on (not 0.0.0.0).
PRIVATE_BIND_IP=192.168.1.10
PRIVATE_PORT=8443

# Public MCP origin served by the tunnel: origin only, https, no path.
PUBLIC_BASE_URL=https://mcp.example.ts.net
PUBLIC_PORT=8080
# Strict redirect-host allowlist for OAuth clients (comma-separated hostnames).
# Empty = log-and-allow any https host: use only while testing client compatibility.
ALLOWED_REDIRECT_HOSTS=

FIRST_USER_ADMIN=1
INVITE_ONLY=0
